# Microsoft Defender for Endpoint Credentials
# Copy this file to .env and fill in your actual values

# Azure AD / Microsoft Entra ID Application Settings
DEFENDER_TENANT_ID=your-tenant-id-here
DEFENDER_CLIENT_ID=your-client-id-here
DEFENDER_CLIENT_SECRET=your-client-secret-here

# Optional: Override Microsoft Graph advanced-hunting defaults
# DEFENDER_GRAPH_SCOPE=https://graph.microsoft.com/.default
# DEFENDER_GRAPH_SECURITY_BASE_URL=https://graph.microsoft.com/v1.0/security
